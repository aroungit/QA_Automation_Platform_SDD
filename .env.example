# QA_Automation_Platform_Agent — environment configuration
# Copy to .env and fill in values. Never commit .env.

# ---------- Server ----------
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# ---------- LLM providers (generation; shown in the UI dropdown) ----------
# Provider used when the client does not choose one: groq | cohere | openrouter
DEFAULT_LLM_PROVIDER=groq

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile

COHERE_API_KEY=
COHERE_BASE_URL=https://api.cohere.com
COHERE_DEFAULT_MODEL=command-r-plus

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini

LLM_TIMEOUT_MS=60000
LLM_TEMPERATURE=0.2

# ---------- Embeddings / reranking (RESERVED — later enhancement, not used yet) ----------
VOYAGE_API_KEY=
VOYAGE_BASE_URL=https://api.voyageai.com/v1
VOYAGE_EMBEDDING_MODEL=voyage-3
VOYAGE_RERANK_MODEL=rerank-2

JINA_API_KEY=
JINA_BASE_URL=https://api.jina.ai/v1
JINA_EMBEDDING_MODEL=jina-embeddings-v3
JINA_RERANK_MODEL=jina-reranker-v2-base-multilingual

# ---------- Storage (file based, no database) ----------
SPECS_DIR=./specs
AUTOMATION_DIR=./automation
REPORTS_DIR=./reports
TEMP_WORKSPACE_DIR=./.workspace

# ---------- Target applications ----------
ORANGEHRM_BASE_URL=https://opensource-demo.orangehrmlive.com
ORANGEHRM_USERNAME=Admin
ORANGEHRM_PASSWORD=admin123
REACT_APP_BASE_URL=http://localhost:3000

# ---------- Mobile test configuration ----------
MOBILE_DEVICE=Pixel 7
MOBILE_EMULATOR_NAME=
MOBILE_APP_PATH=

# ---------- Auto-heal (Playwright healer agent) ----------
HEAL_MAX_ATTEMPTS=3

# ---------- Clients ----------
VITE_API_BASE_URL=http://localhost:4000
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
